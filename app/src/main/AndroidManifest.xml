<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========== مجوزهای ضروری ========== -->

    <!-- دسترسی به اینترنت -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- بررسی وضعیت شبکه -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- برای اجرای VPN به صورت Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- برای اندروید 14+ (API 34+) - نوع Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- برای اندروید 13+ (API 33+) - نمایش نوتیفیکیشن VPN -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- برای اندروید 11+ (API 30+) - جهت نمایش کامل لیست برنامه‌ها در TunnelAppsActivity -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- برای بستن فرآیندهای پس‌زمینه‌ی برنامه‌های انتخاب‌نشده در حالت مسدودسازی -->
    <uses-permission
        android:name="android.permission.KILL_BACKGROUND_PROCESSES"
        tools:ignore="ProtectedPermissions" />

    <!-- ========== دیدپذیری برنامه‌ها (اندروید 11+) ========== -->
    <!-- جایگزین/مکمل QUERY_ALL_PACKAGES برای دیدن اپ‌های دارای لانچر -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- فعالیت اصلی برنامه -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- صفحه تنظیمات -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- صفحه تونل برنامه‌ها -->
        <activity
            android:name=".TunnelAppsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- فعالیت مدیریت و تنظیمات DNS -->
        <activity
            android:name=".DnsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- درباره ما -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- سرویس وی‌پی‌ان -->
        <service
            android:name=".MyVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <!-- برای اندروید 14+ - توضیح استفاده از Foreground Service -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN service for DNS management" />
        </service>

    </application>

</manifest>
