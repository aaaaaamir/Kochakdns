<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.kochakdns"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!-- ========== مجوزهای ضروری ========== -->


    <!-- دسترسی به اینترنت -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- بررسی وضعیت شبکه -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- برای اجرای VPN به صورت Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- برای اندروید 14+ (API 34+) - نوع Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- برای اندروید 13+ (API 33+) - نمایش نوتیفیکیشن VPN -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- برای اندروید 11+ (API 30+) - جهت نمایش کامل لیست برنامه‌ها در TunnelAppsActivity -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <permission
        android:name="com.example.kochakdns.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.kochakdns.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar" >

        <!-- فعالیت اصلی برنامه -->
        <activity
            android:name="com.example.kochakdns.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- صفحه تنظیمات -->
        <activity
            android:name="com.example.kochakdns.SettingsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- صفحه تونل برنامه‌ها -->
        <activity
            android:name="com.example.kochakdns.TunnelAppsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- فعالیت مدیریت و تنظیمات DNS -->
        <activity
            android:name="com.example.kochakdns.DnsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- درباره ما -->
        <activity
            android:name="com.example.kochakdns.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- سرویس وی‌پی‌ان -->
        <service
            android:name="com.example.kochakdns.MyVpnService"
            android:exported="true"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE" >
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <!-- برای اندروید 14+ - توضیح استفاده از Foreground Service -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN service for DNS management" />
        </service>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.kochakdns.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>